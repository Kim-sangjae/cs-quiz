{
  "name": "cs-quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue; next dev -H 0.0.0.0\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts",
    "fresh": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue; npm run build; npm run start\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.20.0",
    "canvas-confetti": "^1.9.4",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "next-nprogress-bar": "^2.4.7",
    "nodemailer": "^7.0.13",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
