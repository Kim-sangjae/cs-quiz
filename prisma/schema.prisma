datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  nickname      String?   @unique
  avatarUrl     String?
  bio           String?   @db.VarChar(20)
  role          Role      @default(USER)
  tokenVersion  Int       @default(0)
  deletedAt        DateTime?
  adminLastSeenAt  DateTime?
  streakCount      Int       @default(0)
  lastQuizDate     DateTime?
  points              Int               @default(0)
  profileVisibility   ProfileVisibility @default(PUBLIC)
  createdAt           DateTime          @default(now())

  accounts         Account[]
  sessions         Session[]
  quizSessions     QuizSession[]
  questions        Question[]
  attempts         QuestionAttempt[]
  likes            Like[]
  reports          Report[]
  notifications    Notification[]
  inquiries        Inquiry[]
  auditLogs        AuditLog[]
  errorLogs        ErrorLog[]
  sentRequests     Friendship[]  @relation("FriendRequester")
  receivedRequests Friendship[]  @relation("FriendAddressee")
  presence                   UserPresence?
  dailyVisits                DailyVisit[]
  dailyChallengeCompletions  DailyChallengeCompletion[]
  badges                     UserBadge[]
  reviewSchedules            ReviewSchedule[]
  hostedRooms                GameRoom[]    @relation("GameRoomHost")
  guestRooms                 GameRoom[]    @relation("GameRoomGuest")
  sentUserReports            UserReport[]  @relation("UserReportReporter")
  receivedUserReports        UserReport[]  @relation("UserReportReported")
  questionComments           QuestionComment[]
  commentReports             CommentReport[]
  questionNotes              QuestionNote[]
  bookmarkFolders            BookmarkFolder[]
  pointTransactions          PointTransaction[]
  weeklyGoalClaims           WeeklyGoalClaim[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model Question {
  id              String         @id @default(cuid())
  authorId        String?
  category        String
  question        String
  options         Json
  answer          Int
  explanation     String
  status          QuestionStatus @default(PENDING)
  rejectionReason String?
  attemptCount    Int            @default(0)
  correctCount    Int            @default(0)
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime       @default(now())

  author          User?             @relation(fields: [authorId], references: [id])
  attempts        QuestionAttempt[]
  likes           Like[]
  reports         Report[]
  reviewSchedules ReviewSchedule[]
  comments        QuestionComment[]
  notes           QuestionNote[]
}

enum QuestionStatus {
  OFFICIAL
  PENDING
  APPROVED
  REJECTED
  BLINDED
}

model QuizSession {
  id          String   @id @default(cuid())
  userId      String
  category    String
  questionIds Json
  answers     Json
  score       Int
  mode        String   @default("normal")
  submittedAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id])
  attempts QuestionAttempt[]
}

model QuestionAttempt {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  sessionId   String
  selected    Int
  isCorrect   Boolean
  attemptedAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])
  session  QuizSession @relation(fields: [sessionId], references: [id])
}

model Like {
  userId     String
  questionId String
  folderId   String?
  createdAt  DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id])
  question Question        @relation(fields: [questionId], references: [id])
  folder   BookmarkFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@id([userId, questionId])
  @@index([userId, folderId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  questionId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  reporter User     @relation(fields: [reporterId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([reporterId, questionId])
}

enum ReportReason {
  INAPPROPRIATE
  ERROR
  DUPLICATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  actionUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  QUESTION_APPROVED
  QUESTION_REJECTED
  ROLE_CHANGED
  INQUIRY_REPLIED
  LEVEL_UP
  BADGE_EARNED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_REJECTED
  BATTLE_INVITE
  BATTLE_REJECTED
  BATTLE_QUIT_REQUEST
  NICKNAME_FORCED_CHANGED
  ACCOUNT_BLINDED
}

enum BadgeType {
  FIRST_QUIZ
  QUIZ_10
  QUIZ_50
  PERFECT_SCORE
  STREAK_3
  STREAK_7
  CAT_DS
  CAT_ALGO
  CAT_OS
  CAT_NETWORK
  CAT_DB
  CAT_ARCH
  FIRST_SUBMIT
  APPROVED_1
  APPROVED_5
  APPROVED_10
  APPROVED_20
  COMEBACK
  COMPLETIONIST
  LIKED_QUESTION
  BATTLE_FIRST
  BATTLE_WIN_1
  BATTLE_WIN_10
  BATTLE_WIN_30
}

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  badge    BadgeType
  earnedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
}

enum InquiryType {
  BUG_REPORT
  ACCOUNT_ISSUE
  CONTENT_ISSUE
  SUGGESTION
  OTHER
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Inquiry {
  id         String        @id @default(cuid())
  userId     String
  type       InquiryType
  title      String
  content    String
  status     InquiryStatus @default(PENDING)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model DailyChallengeStat {
  date         String @id // YYYY-MM-DD
  questionId   String
  attemptCount Int    @default(0)
  correctCount Int    @default(0)
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model UserPresence {
  userId        String   @id
  lastSeenAt    DateTime @default(now()) @updatedAt
  isPlayingQuiz Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameRoom {
  id           String         @id @default(cuid())
  hostId       String
  guestId      String?
  status       GameRoomStatus @default(WAITING)
  category     String
  questionIds  Json
  hostAnswers  Json           @default("[]")
  guestAnswers Json           @default("[]")
  currentQ      Int            @default(0)
  hostScore     Int            @default(0)
  guestScore    Int            @default(0)
  quitRequestBy        String?
  consecutiveAllSkip   Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  questionStartedAt    DateTime?

  host  User  @relation("GameRoomHost",  fields: [hostId],  references: [id])
  guest User? @relation("GameRoomGuest", fields: [guestId], references: [id])
}

enum GameRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

model DailyVisit {
  userId String
  date   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model DailyChallengeCompletion {
  userId    String
  date      String    // YYYY-MM-DD
  correct   Boolean
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model ErrorLog {
  id         String   @id @default(cuid())
  userId     String?
  statusCode Int?
  errorCode  String?
  message    String
  path       String?
  digest     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model ReviewSchedule {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  step         Int      @default(0)
  nextReviewAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

model BlockedWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
  createdBy String
}

model QuestionComment {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  content    String
  blinded    Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reports  CommentReport[]

  @@index([questionId, createdAt])
  @@index([userId, createdAt])
}

model CommentReport {
  id          String              @id @default(cuid())
  reporterId  String
  commentId   String
  reason      CommentReportReason
  description String?
  status      ReportStatus        @default(PENDING)
  createdAt   DateTime            @default(now())

  reporter User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  comment  QuestionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, commentId])
  @@index([status, createdAt])
}

enum CommentReportReason {
  INAPPROPRIATE
  SPAM
  HARASSMENT
  OTHER
}

model UserReport {
  id           String           @id @default(cuid())
  reporterId   String
  reportedId   String
  reason       UserReportReason
  description  String?
  status       ReportStatus     @default(PENDING)
  createdAt    DateTime         @default(now())

  reporter User @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("UserReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status, createdAt])
}

enum UserReportReason {
  INAPPROPRIATE_NICKNAME
  HARASSMENT
  SPAM
  OTHER
}

model QuestionNote {
  userId     String
  questionId String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId])
}

model BookmarkFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes Like[]

  @@unique([userId, name])
  @@index([userId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyGoalClaim {
  id        String   @id @default(cuid())
  userId    String
  goalKey   String
  points    Int
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalKey])
  @@index([userId])
}
